  // trim
  function trim(s)
  {
    var t = "";
    var from_pos = to_pos = 0;

    for (i=0; i<s.length; i++)
    {
      if (s.charAt(i) == ' ')
      {
        continue;
      }
      else
      {
        from_pos = i;
        break;
      }
    }

    for (i=s.length; i>=0; i--)
    {
      if (s.charAt(i-1) == ' ')
      {
        continue;
      }
      else
      {
        to_pos = i;
        break;
      }
    }

    t = s.substring(from_pos, to_pos);
    return t;
  }

  // trim
  function sTrim(str)
